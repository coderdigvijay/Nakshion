# ---------------------------------------------------------------- required
# Local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/astroai
# Neon: use the POOLED string for the app, the DIRECT string for alembic.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/astroai
REDIS_URL=redis://localhost:6379/0
# Neon: optional DIRECT (unpooled) URL used only by alembic. Pooled URL may carry ?sslmode=require&channel_binding=require.
MIGRATION_DATABASE_URL=
# >= 32 random bytes; production refuses to boot with a weak/example value.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------- app
APP_NAME=Nakshion
APP_ENV=development
APP_VERSION=dev
FRONTEND_URL=http://localhost:5175
API_PUBLIC_URL=http://localhost:8010
CORS_ORIGINS=http://localhost:5175,http://localhost:5173,http://localhost:3000
SOURCE_CODE_URL=
DEFAULT_ANON_TZ=Asia/Kolkata
RATE_LIMIT_ENABLED=true
# Reverse proxies in front of the app. Render: 1. Client IP = Nth entry from the RIGHT of X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
MAX_BODY_BYTES=65536

# Required (>= 32 chars) when APP_ENV=production
CRON_SECRET=change-me
OTP_PEPPER=change-me

# ---------------------------------------------------------------- AI (app/llm reads these)
GEMINI_API_KEY=
# Optional rotation keys: GEMINI_API_KEY1..GEMINI_API_KEY5
ANTHROPIC_API_KEY=
# Production default: 1 (excludes the three modern-author reference notes until provenance is confirmed; also set it when running
# `python -m app.rag.ingest` against the production database).
RAG_EXCLUDE_REVIEW=0
# 512 MB hosts: off (about 113 MB lighter than local, retrieval hit@5 0.907 vs 0.956).
EMBEDDINGS_RUNTIME=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------------------------------------------------------------- geocoding
LOCATIONIQ_API_KEY=
GEOAPIFY_API_KEY=
GEOCODER_FALLBACK=geoapify

# ---------------------------------------------------------------- email (Brevo)
BREVO_API_KEY=
# Must be a sender verified in Brevo (Settings > Senders & Domains).
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Nakshion

# ---------------------------------------------------------------- Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
